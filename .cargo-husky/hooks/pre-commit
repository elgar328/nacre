#!/bin/sh
#
# Installed by cargo-husky's `user-hooks` feature: this file is copied verbatim to
# `.git/hooks/pre-commit` when cargo-husky's build script runs -- the first `cargo test` of a
# clone -- so edit it here, not there. An edit is not re-copied on its own: `cargo clean -p
# cargo-husky` and a `cargo test` copy it again.
#
# Why not the built-in `run-cargo-clippy` feature: it runs `cargo clippy -- -D warnings`, which
# lints only the default target — the library. Anything under `#[cfg(test)]` is invisible to it,
# and an `identity_op` warning rode into 878bb81 that way. Tests are a large share of this repo,
# so they get linted on the same terms as the library.

set -e

echo '+cargo fmt --all -- --check'
cargo fmt --all -- --check
echo '+cargo clippy --workspace --all-targets -- -D warnings'
cargo clippy --workspace --all-targets -- -D warnings
echo '+cargo test --workspace'
cargo test --workspace
# Private items too: the public build does not render their docs, so a broken link there would
# pass. Every doc warning is an error except a public doc linking a private item, which stays a
# link so a rename still breaks it (overview's gate paragraph on `cargo doc`; the gate also runs
# the same line with --all-features).
echo '+RUSTDOCFLAGS="-D warnings -A rustdoc::private_intra_doc_links" cargo doc --workspace --no-deps --document-private-items'
RUSTDOCFLAGS="-D warnings -A rustdoc::private_intra_doc_links" cargo doc --workspace --no-deps --document-private-items
